#!/usr/bin/python3
"""Show Claude's last answers block by block, and copy the blocks you pick.

A copy from the screen is a copy of the grid. Claude draws a code block two
columns in, and wraps it at the width of the pane, so a copied block keeps
that indent and a break inside each long line. The transcript holds each
answer as Claude wrote it, so the picker reads the answers there and copies
the markdown of a block, or the content of a code block, as written.

The script never types /copy into Claude. A /copy makes Claude send a
recap a few minutes later, and on a cold cache that recap writes the whole
context to the cache again.

Herdr runs this script in a popup over the pane where the key was pressed.
The popup gives the picker the keys, and that pane gives it the agent.

The * key types the shell blocks into a free shell of the tab, as a run of
steps: bin/running.py says how. The v key types the code there as it is.
"""

import base64
import curses
import json
import os
import re
import sys

try:
    import pygments.lexers
    import pygments.token
    import pygments.util
except ImportError:
    pygments = None

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import api
import prompting
import running
import sessions

# a block in a list item takes the indent of the item, and a block closes
# on a run of its opening mark, at least as long
FENCE = re.compile(r'^( *)(`{3,}|~{3,})(.*)$')
HEADING = re.compile(r'^ {0,3}#{1,6}\s')
ITEM = re.compile(r'^(\s*(?:[-*+]|\d+[.)])\s+)')
# a list may start right under the line that announces it, with no blank
# line between, as long as it opens on a bullet or on 1
LEAD = re.compile(r'^ {0,3}(?:[-*+]|1[.)])\s')
INLINE = re.compile(r'`([^`]+)`|\*\*([^*]+)\*\*')
TAG = re.compile(r'<[^>]*>')
COMMAND = re.compile(r'<command-name>(.*?)</command-name>')
# the mark that makes Claude Code run a line in its shell. Claude writes it
# as a ! and a space, at times as a ! alone. A line that opened on the
# negation of bash would lose it too, and Claude almost never writes one.
BANG = re.compile(r'^![ \t]*', re.MULTILINE)
SHELLS = ('', 'sh', 'bash', 'zsh', 'shell')
# the markers of a paste: inside them, a newline is text, and not the Enter
# that would send the first line alone
PASTE = '\033[200~{}\033[201~'
# what a paste must not carry, since Herdr sends it as it is: an escape
# could close the paste early, and the newline after it would send the line
CONTROLS = re.compile(r'[\x00-\x08\x0b-\x1f\x7f-\x9f]')
ARGS = re.compile(r"<command-args>(.*?)</command-args>", re.DOTALL)
SHELL_INPUT = re.compile(r'<bash-input>(.*?)</bash-input>', re.DOTALL)
# what Claude Code records after a local command or a ! command: the end of
# the turn that the command opened, not a prompt of its own
OUTPUTS = ('<bash-stdout>', '<bash-stderr>', '<local-command-stdout>',
           '<local-command-stderr>')

TAIL = 4 << 20      # a transcript can pass 40 MB, and the picker shows its last answers
CUT = '(the prompt of this turn is too far back in the transcript)'
GUTTER = 7          # the row number, the bar of the cursor, and a space each
# the rule between two messages of a turn. Claude almost never writes a line
# of it alone, so it does not read as a line of a message. It is drawn and
# never copied.
RULE = '╌'

# each action of the picker, and its letter by default. The keys file gives an
# action another letter, and the named keys keep their action whatever it says.
LETTERS = {
    'down': 'j', 'up': 'k', 'code-next': '', 'code-previous': '',
    'first': 'g', 'last': 'G', 'previous': 'p', 'next': 'n', 'every': 'w',
    'page-down': '', 'page-up': '', 'mark': '', 'all': 'a', 'code': 'c',
    'answer': 'A', 'copy': '', 'claude': '!', 'shell': '$', 'run': '*',
    'paste': 'v', 'help': '?', 'quit': 'q',
}
# the file holds one printable character after its =, so a Space or a Ctrl key
# is named here: the file could not give it back to its action
NAMED = {
    'KEY_DOWN': 'down', 'KEY_UP': 'up', '\t': 'code-next', 'KEY_BTAB': 'code-previous',
    'KEY_HOME': 'first', 'KEY_END': 'last', 'KEY_LEFT': 'previous', 'KEY_RIGHT': 'next',
    '\x04': 'page-down', 'KEY_NPAGE': 'page-down', '\x15': 'page-up', 'KEY_PPAGE': 'page-up',
    ' ': 'mark', '\n': 'copy', '\r': 'copy', 'KEY_ENTER': 'copy', '\x1b': 'quit',
}
SHOWN = {'down': '↓', 'up': '↑', 'code-next': 'Tab', 'code-previous': 'S-Tab',
         'previous': '←', 'next': '→', 'page-down': 'C-d', 'page-up': 'C-u',
         'mark': 'Space', 'copy': 'Enter', 'quit': 'Esc'}
MOVES = {'down': 1, 'up': -1}
CODE = {'code-next': 1, 'code-previous': -1}
ENDS = {'first': 0, 'last': -1}
TURNS = {'next': 1, 'previous': -1}
SCROLLS = {'page-down': 1, 'page-up': -1}
TO_RUN = ('claude', 'shell', 'run', 'paste')
FOOTER = ('↑↓ move · enter copy · {claude} for Claude · {shell} for a shell'
          ' · {run} for a run · space mark · {all} all · {help} help · {quit} quit')
# the keys of each row are the actions whose keys it shows, and a text names a
# key by its action in braces
HELP = (
    (('down', 'up'), 'next or previous block'),
    (('code-next', 'code-previous'), 'next or previous block of code'),
    (('first', 'last'), 'first or last block'),
    (('mark',), 'mark the block at the cursor, for a copy of several'),
    (('all',), 'mark every block, or unmark them all'),
    (('code',), 'mark every block of code, or unmark them all'),
    (('copy',), 'copy the selection as written, else the block at the cursor'),
    (('claude',), 'copy its code to run in Claude, and put it in the prompt box'),
    (('shell',), 'copy its code to run in a shell: no ! at all'),
    (('run',), 'put its shell code in a free shell of the tab, as a run of steps'),
    (('paste',), 'put its code in a free shell of the tab, as {shell} copies it'),
    (('answer',), 'copy the whole answer as written, and quit'),
    (('previous', 'next'), 'previous or next answer'),
    (('every',), 'every message of the turn, or its last one alone'),
    (('page-down', 'page-up'), 'scroll half a page'),
    (('help',), 'this help'),
    (('quit',), 'quit with no copy'),
    ((), ''),
    (('copy',), 'Blocks of code alone are copied as their content, ready to run.'),
    ((), 'A selection with prose is copied as markdown, fences included.'),
    (('claude', 'shell'), 'Only the blocks of code of the selection, and never its prose.'),
    ((), '{claude} puts one ! in front of them all, and {shell} none at all.'),
    ((), '{claude} and {run} leave out a block that is not shell, and say so.'),
    (('run',), 'Enter in that shell starts the run, a step per block.'),
    ((), 'Each step keeps its output in a directory of its own.'),
    (('paste',), 'Enter in that shell runs the code as you would type it.'),
    (('all', 'claude'), 'Every shell command of the answer, in the prompt box of Claude.'),
    (('all', 'shell'), 'Every block of code of the answer, for a shell.'),
    ((), '{mark} after {all} takes a block out of either.'),
    (('all', 'code'), 'The prose of the answer alone.'),
    ((), ''),
    ((), 'Any key closes this help.'),
)

ITALIC = getattr(curses, 'A_ITALIC', 0)
BOLD = curses.A_BOLD
# the palette in 256 colours: (foreground, background, attribute).
# The text on the pane, the prompt on a ground of its own, the code on the dark
# ground of its panel. A style that ends in -cursor, -mark or -both replaces
# its base in the block at the cursor, in a marked block, or in a marked block
# at the cursor: orange, mauve, and red, so that a mark under the cursor shows.
STYLES = {
    'text': (-1, -1, 0), 'bold': (-1, -1, BOLD), 'inline': (151, -1, 0),
    'heading': (183, -1, BOLD), 'quote': (245, -1, ITALIC),
    'text-cursor': (-1, 237, 0), 'bold-cursor': (-1, 237, BOLD),
    'inline-cursor': (151, 237, 0), 'heading-cursor': (183, 237, BOLD),
    'quote-cursor': (245, 237, ITALIC),
    'title': (-1, -1, BOLD), 'help': (242, -1, 0), 'help-key': (216, -1, BOLD),
    'warn': (211, -1, BOLD), 'rule': (242, -1, 0),
    'prompt': (189, 238, 0), 'prompt-more': (245, 238, ITALIC),
    'gutter': (242, -1, 0), 'gutter-cursor': (216, -1, BOLD),
    'gutter-mark': (183, -1, BOLD), 'gutter-both': (211, -1, BOLD),
    'bar-cursor': (216, -1, 0), 'bar-mark': (183, -1, 0), 'bar-both': (211, -1, 0),
    'head': (245, 238, 0), 'head-number': (189, 238, BOLD),
    'head-cursor': (236, 216, 0), 'head-number-cursor': (236, 216, BOLD),
    'head-mark': (236, 183, 0), 'head-number-mark': (236, 183, BOLD),
    'head-both': (236, 211, 0), 'head-number-both': (236, 211, BOLD),
    'code': (189, 236, 0), 'keyword': (183, 236, 0), 'string': (151, 236, 0),
    'comment': (242, 236, ITALIC), 'literal': (216, 236, 0),
    'builtin': (111, 236, 0), 'variable': (211, 236, 0), 'operator': (117, 236, 0),
}
# the same, on a terminal of eight colours
BASIC = {151: curses.COLOR_GREEN, 183: curses.COLOR_MAGENTA, 216: curses.COLOR_YELLOW,
         111: curses.COLOR_BLUE, 211: curses.COLOR_RED, 117: curses.COLOR_CYAN,
         189: curses.COLOR_WHITE, 245: curses.COLOR_WHITE, 242: curses.COLOR_WHITE,
         236: curses.COLOR_BLACK, 237: curses.COLOR_BLACK, 238: curses.COLOR_BLACK}
TOKENS = (('Comment', 'comment'), ('Keyword', 'keyword'),
          ('Name.Builtin', 'builtin'), ('Name.Function', 'builtin'),
          ('Name.Variable', 'variable'), ('Literal.String', 'string'),
          ('Literal.Number', 'literal'), ('Operator', 'operator'))


def first_line(text):
    return next((line.strip() for line in text.splitlines() if line.strip()), '')


def _prompt(content):
    """The prompt as it was typed: a command with its arguments, and any
    other text without the tags that Claude Code wraps around it."""
    if isinstance(content, list):
        content = '\n'.join(
            block.get('text') or '' if block.get('type') == 'text' else '[image]'
            for block in content if isinstance(block, dict))
    content = content or ''
    command = COMMAND.search(content)
    if command:
        args = ARGS.search(content)
        return f"{command.group(1)} {args.group(1) if args else ''}".strip()
    shell = SHELL_INPUT.search(content)
    if shell:
        return '! ' + shell.group(1).strip()
    return TAG.sub('', content).strip('\n')


def _tool_result(content):
    return isinstance(content, list) and any(
        isinstance(block, dict) and block.get('type') == 'tool_result'
        for block in content)


def _output(content):
    return isinstance(content, str) and content.lstrip().startswith(OUTPUTS)


def answers(path):
    """The answers of a session, oldest first, each with the prompt it follows.

    An answer holds the messages of Claude in a turn, in their order. The
    picker shows the last one, as Claude's own /copy takes it. A turn that
    runs tools holds other messages before it, a few words between two
    tools. The records of one message share its id.

    Each user record opens a turn, unless it is a tool result, the output of
    a command, or a record that Claude Code adds itself. A local command also
    opens a turn, but Claude writes nothing in it.

    Only the tail of the transcript is read, and its start can cut a turn.
    The messages of that turn that the tail holds stay, under CUT, since one
    turn can write more than the tail holds. The first of them can lose its
    beginning.
    """
    try:
        with open(path, 'rb') as fp:
            fp.seek(0, 2)
            size = fp.tell()
            fp.seek(max(0, size - TAIL))
            lines = fp.readlines()
    except (OSError, TypeError):
        return []
    found, turn = [], None
    if size > TAIL:
        lines, turn = lines[1:], {'prompt': CUT, 'id': None, 'messages': []}
        found.append(turn)
    for raw in lines:
        try:
            record = json.loads(raw)
        except ValueError:
            continue
        if not isinstance(record, dict) or record.get('isSidechain'):
            continue
        message = record.get('message') or {}
        content = message.get('content')
        if record.get('type') == 'user':
            if not record.get('isMeta') and not record.get('isCompactSummary') \
                    and not _tool_result(content) and not _output(content):
                turn = {'prompt': _prompt(content), 'id': None, 'messages': []}
                found.append(turn)
        elif record.get('type') == 'assistant' and turn is not None \
                and isinstance(content, list):
            texts = [block['text'] for block in content
                     if isinstance(block, dict) and block.get('type') == 'text'
                     and block.get('text')]
            if not texts:
                continue
            if not turn['messages'] or turn['id'] != message.get('id'):
                turn['id'] = message.get('id')
                turn['messages'].append([])
            turn['messages'][-1].extend(texts)
    return [{'prompt': answer['prompt'],
             'messages': ['\n\n'.join(texts) for texts in answer['messages']]}
            for answer in found if answer['messages']]


def _dedent(line, width):
    return line[min(width, len(line) - len(line.lstrip(' '))):]


def blocks(text):
    """The blocks of an answer in their order: each fenced block of code, and
    the markdown around them, cut at its blank lines and at its headings.

    A list keeps the blank lines between its items and stays one block. The
    indent of an opening fence belongs to the list item that holds the code,
    so the same indent comes off each line of the code.
    """
    found, chunk, lines, i = [], [], text.split('\n'), 0

    def close():
        if not chunk:
            return
        first = chunk[0].lstrip()
        kind = 'list' if ITEM.match(chunk[0]) else 'table' if first.startswith('|') \
            else 'quote' if first.startswith('>') else 'paragraph'
        source = '\n'.join(chunk)
        last = found[-1] if found else None
        if last and last['kind'] == 'list' \
                and (kind == 'list' or chunk[0].startswith('  ')):
            last['source'] = last['text'] = last['source'] + '\n\n' + source
        else:
            found.append({'kind': kind, 'lang': '', 'indent': 0,
                          'source': source, 'text': source})
        chunk.clear()

    while i < len(lines):
        line = lines[i]
        i += 1
        opening = FENCE.match(line)
        if opening:
            close()
            indent, mark, info = opening.groups()
            body, fenced = [], [line]
            while i < len(lines):
                closing = FENCE.match(lines[i])
                fenced.append(lines[i])
                i += 1
                if closing and closing.group(2)[0] == mark[0] \
                        and len(closing.group(2)) >= len(mark) \
                        and not closing.group(3).strip():
                    break
                body.append(_dedent(lines[i - 1], len(indent)))
            found.append({
                'kind': 'code', 'lang': (info.split() or [''])[0],
                'indent': len(indent), 'text': '\n'.join(body),
                'source': '\n'.join(_dedent(row, len(indent)) for row in fenced)})
        elif not line.strip():
            close()
        elif HEADING.match(line):
            close()
            found.append({'kind': 'heading', 'lang': '', 'indent': 0,
                          'source': line, 'text': line})
        else:
            if chunk and LEAD.match(line) and not ITEM.match(chunk[0]):
                close()
            chunk.append(line)
    close()
    return found


def paged(prompt, messages):
    """The page of a turn: its last message and its blocks.

    Under 'every', the same turn shows all its messages. Both are built at
    once, so the w key reads nothing. Each message is cut into blocks on its
    own: a fence left open in one cannot take in the next. Every block
    carries the number of its message, and layout() draws a rule where that
    number changes.
    """
    every = [dict(block, message=n) for n, text in enumerate(messages)
             for block in blocks(text)]
    last = len(messages) - 1
    page = {'prompt': prompt, 'text': messages[-1], 'messages': len(messages),
            'blocks': [block for block in every if block['message'] == last]}
    page['every'] = dict(page, text='\n\n'.join(messages), blocks=every)
    return page


def pages(path):
    """What the picker pages through: the page of each answer."""
    return [paged(answer['prompt'], answer['messages']) for answer in answers(path)]


def shown(book, state):
    """The page on screen: the last message of its turn, or every message."""
    page = book[state['page']]
    return page['every'] if state['every'] else page


def start(book, page, every=False):
    """An answer as it opens: the cursor on its first block of code, if any."""
    state = {'page': page, 'every': every, 'cursor': 0, 'marked': frozenset(),
             'top': 0, 'follow': True, 'help': False, 'said': ''}
    found = shown(book, state)['blocks']
    return dict(state, cursor=next(
        (i for i, block in enumerate(found) if block['kind'] == 'code'), 0))


def opened(book):
    return start(book, len(book) - 1)


def toggled(state, book):
    """The same turn in the other mode, with no mark.

    The blocks of the last message end the blocks of every message, so the
    cursor keeps its block when the other mode shows it. A block of an
    earlier message has no place among those of the last one.
    """
    page = book[state['page']]
    shift = len(page['every']['blocks']) - len(page['blocks'])
    cursor = state['cursor'] + (-shift if state['every'] else shift)
    fresh = start(book, state['page'], not state['every'])
    return fresh if cursor < 0 else dict(fresh, cursor=cursor)


def keys_file():
    return os.path.join(os.path.dirname(sessions.sources_file()), 'keys')


def _fault(lines):
    """What is wrong in the lines of a keys file, and the letters it gives.

    An action is bound once in the file, and a key holds one action once the
    file is laid over the defaults, so that down = k alone cannot take k
    from up.
    """
    keys, at = dict(LETTERS), {}
    for n, line in enumerate(lines, 1):
        line = line.strip()
        if not line or line.startswith('#'):
            continue
        action, equal, key = (part.strip() for part in line.partition('='))
        if not equal:
            return n, 'write it as action = key', keys
        if action not in LETTERS:
            return n, f'no action is named {action!r}: the README lists them', keys
        if action in at:
            return n, f'{action} is bound already, on line {at[action]}', keys
        if len(key) != 1 or not key.isprintable() or key.isspace():
            return n, f'give {action} one printable character, not {key!r}', keys
        keys[action], at[action] = key, n
    # at keeps the order of the lines, so a clash names its later line
    owner = {letter: action for action, letter in LETTERS.items()
             if letter and action not in at}
    for action, n in at.items():
        other = owner.setdefault(keys[action], action)
        if other != action:
            return n, (f'{keys[action]} is the key of {other} too: '
                       'give one of them another key'), keys
    return None, '', keys


def bindings(path=None):
    """The letter of each action, and why the keys file was refused, if it
    was. A file refused binds nothing, so that the keys that the user knows
    still work."""
    path = path or keys_file()
    where = running.tilde(path)
    try:
        with open(path, encoding='utf-8') as fp:
            lines = fp.read().splitlines()
    except FileNotFoundError:
        return dict(LETTERS), ''
    except ValueError:
        fault = f'write {where} in UTF-8'
    except OSError as why:
        fault = f'{where}: {why.strerror}'
    else:
        n, fault, keys = _fault(lines)
        if not fault:
            return keys, ''
        fault = f'{where}, line {n}: {fault}'
    return dict(LETTERS), f'{fault}. The default keys hold.'


def label(keys, actions):
    """The keys of these actions in the help: their letters, then their named
    keys."""
    return '  '.join([keys[action] for action in actions if keys[action]]
                     + [SHOWN[action] for action in actions if action in SHOWN])


def names(keys):
    """The key that a text of the help or the footer names for each action:
    its letter, else its named key."""
    return {action: letter or SHOWN.get(action, '') for action, letter in keys.items()}


def helped(keys):
    """The rows of the help, with the keys as they are bound."""
    named = names(keys)
    return [(label(keys, actions), what.format_map(named)) for actions, what in HELP]


def action_of(key, keys):
    """The action of a key: its named action, else the action bound to it."""
    return NAMED.get(key) or next((action for action, letter in keys.items()
                                   if letter == key), None)


def step(state, key, book, height=20, keys=LETTERS):
    """Apply one key: the new state, and the action that ends the picker, if
    it does: 'copy', an action of TO_RUN, or 'quit'.

    A key that closes the help does nothing else, so a q read there quits
    nothing.
    """
    if state['help']:
        return dict(state, help=False), None
    action = action_of(key, keys)
    if action == 'help':
        return dict(state, help=True), None
    found = shown(book, state)['blocks']
    if action in MOVES:
        cursor = max(0, min(len(found) - 1, state['cursor'] + MOVES[action]))
        return dict(state, cursor=cursor, follow=True), None
    if action in CODE:
        way = CODE[action]
        ahead = range(state['cursor'] + way, len(found) if way > 0 else -1, way)
        cursor = next((i for i in ahead if found[i]['kind'] == 'code'),
                      state['cursor'])
        return dict(state, cursor=cursor, follow=True), None
    if action in ENDS:
        return dict(state, cursor=ENDS[action] % len(found), follow=True), None
    if action in TURNS:
        page = max(0, min(len(book) - 1, state['page'] + TURNS[action]))
        return (state if page == state['page']
                else start(book, page, state['every'])), None
    if action == 'every':
        return toggled(state, book), None
    if action in SCROLLS:
        top = max(0, state['top'] + SCROLLS[action] * max(1, height // 2))
        return dict(state, top=top, follow=False), None
    if action == 'mark':
        return dict(state, marked=state['marked'] ^ {state['cursor']}), None
    whole = frozenset(range(len(found)))
    if action == 'all':
        return dict(state, marked=frozenset() if state['marked'] == whole
                    else whole), None
    if action == 'code':
        code = frozenset(i for i, block in enumerate(found) if block['kind'] == 'code')
        return dict(state, marked=state['marked'] - code if code <= state['marked']
                    else state['marked'] | code), None
    if action == 'answer':
        return dict(state, marked=whole), 'copy'
    if action in ('copy', *TO_RUN, 'quit'):
        return state, action
    return state, None


def selection(state, page):
    """The text to copy, and what it is called.

    If every block of an answer of several is marked, the copy is the answer
    as written. If the selection holds blocks of code only, the copy is their
    content, ready to run. If it also holds prose, the copy is an extract of
    the answer, and each block keeps its markdown, fences included.
    """
    found = page['blocks']
    if len(found) > 1 and len(state['marked']) == len(found):
        return page['text'], 'the whole answer'
    picked = [found[i] for i in sorted(state['marked'])] or [found[state['cursor']]]
    if all(block['kind'] == 'code' for block in picked):
        text = '\n'.join(block['text'] for block in picked)
    else:
        text = '\n\n'.join(block['source'] for block in picked)
    if len(picked) > 1:
        return text, f'{len(picked)} blocks'
    if picked[0]['kind'] == 'code':
        return text, f"the {picked[0]['lang'] or 'code'} block"
    return text, f"a {picked[0]['kind']}"


class Refused(Exception):
    """Why a key copied nothing, in the words that the picker shows."""


def commands(state, page):
    """The blocks of code in the selection, in the order of the answer."""
    found = page['blocks']
    picked = sorted(state['marked']) or [state['cursor']]
    return [found[i] for i in picked if found[i]['kind'] == 'code']


def prepared(done, state, page):
    """What a key copies or runs, and what it is called.

    Enter copies the selection as written. ! and $ copy its code alone, one
    block after the other, to run: in Claude behind a single !, or in another
    shell with no ! at all. * keeps the blocks apart, a list of them, since
    each block runs as a step of its own. Claude and a run hand their code to
    a shell, so ! and * leave out a block in another language, as they leave
    out the prose. v types the code of $ into a shell, such a block included:
    the user reads it there and runs it by hand.
    """
    if done == 'copy':
        return selection(state, page)
    code = commands(state, page)
    if not code:
        raise Refused('no block of code in the selection')
    left = []
    if done in ('claude', 'run'):
        left = [block for block in code if block['lang'] not in SHELLS]
        code = [block for block in code if block['lang'] in SHELLS]
        if not code:
            raise Refused(('Claude' if done == 'claude' else 'a shell')
                          + ' runs shell code, not '
                          + ', '.join(sorted({block['lang'] for block in left})))
    what = f'{len(code)} blocks' if len(code) > 1 \
        else f"the {code[0]['lang'] or 'code'} block"
    out = ''
    if left:
        langs = '/'.join(sorted({block['lang'] for block in left}))
        out = f", {len(left)} {langs} block{'s' if len(left) > 1 else ''} left out"
    if done == 'run':
        return ([BANG.sub('', block['text']).strip('\n') for block in code],
                f'{what} in the free shell{out}')
    text = BANG.sub('', '\n'.join(block['text'] for block in code)).strip('\n')
    if done == 'shell':
        return text, f'{what} for a shell'
    if done == 'paste':
        return text, what
    return '!' + text, f'{what} for Claude{out}'


def said(what, text):
    count = text.count('\n') + 1
    return f"copied {what}, {count} line{'s' if count > 1 else ''}"


def clip(text, terminal=None):
    """Herdr turns an OSC 52 sequence of a pane into a clipboard write, so the
    copy needs no clipboard tool."""
    terminal = terminal or sys.stdout
    terminal.write('\033]52;c;' + base64.b64encode(text.encode()).decode() + '\a')
    terminal.flush()


def spans(line, base='text'):
    """A line of markdown as runs of styled text, without the marks."""
    out, at = [], 0
    for found in INLINE.finditer(line):
        if found.start() > at:
            out.append((line[at:found.start()], base))
        if found.group(1) is not None:
            out.append((found.group(1), 'inline'))
        else:
            out.extend(spans(found.group(2), 'bold'))
        at = found.end()
    if at < len(line):
        out.append((line[at:], base))
    return out


def wrap(runs, width, hang=0):
    """Rows of at most width columns, cut between words.

    The rows after the first start hang columns in, under the text of a list
    item rather than under its mark.
    """
    rows, row, used = [], [], 0
    for text, style in runs:
        for word in re.findall(r'\s*\S+|\s+', text):
            if used > hang and used + len(word) > width:
                rows.append(row)
                row, used, word = [(' ' * hang, style)], hang, word.lstrip()
            while used + len(word) > width:
                room = max(1, width - used)
                row.append((word[:room], style))
                rows.append(row)
                row, used, word = [(' ' * hang, style)], hang, word[room:]
            row.append((word, style))
            used += len(word)
    rows.append(row)
    return rows


def cut(runs, width):
    """Rows of at most width columns, cut at any character, as code is."""
    rows, row, used = [], [], 0
    for text, style in runs:
        while text:
            if used == width:
                rows.append(row)
                row, used = [], 0
            piece = text[:width - used]
            row.append((piece, style))
            used += len(piece)
            text = text[len(piece):]
    rows.append(row)
    return rows


def highlight(code, lang):
    """The lines of a block of code as runs of styled text.

    Pygments colours them when it is installed and knows the language, and
    otherwise the code keeps one colour.
    """
    plain = [[(line, 'code')] for line in code.split('\n')]
    if not pygments or not lang:
        return plain
    try:
        lexer = pygments.lexers.get_lexer_by_name(lang, stripnl=False,
                                                  ensurenl=False)
    except pygments.util.ClassNotFound:
        return plain
    kinds = [(pygments.token.string_to_tokentype(name), style)
             for name, style in TOKENS]
    lines = [[]]
    for kind, value in lexer.get_tokens(code):
        style = next((style for token, style in kinds if kind in token), 'code')
        for n, piece in enumerate(value.split('\n')):
            if n:
                lines.append([])
            if piece:
                lines[-1].append((piece, style))
    return lines


def prose(line, kind, width):
    """The rows of one line of markdown outside the code."""
    if not line.strip():
        return [[]]
    if kind == 'heading':
        return wrap([(HEADING.sub('', line).strip(), 'heading')], width)
    if kind == 'table':
        return cut(spans(line), width)[:1]
    item = ITEM.match(line)
    hang = len(item.group(1)) if item else len(line) - len(line.lstrip())
    return wrap(spans(line, 'quote' if kind == 'quote' else 'text'), width, hang)


def panel(block, number, width):
    """The rows of a block of code: its number and language on a header row,
    then its lines on a dark ground, at the indent of the list item."""
    pad = [(' ' * block['indent'], 'text')]
    inner = max(10, width - block['indent'])
    label, lang = f' {number}', f"{block['lang']} "
    rows = [pad + [(label, 'head-number'),
                   (' ' * max(1, inner - len(label) - len(lang)), 'head'),
                   (lang, 'head')]]
    for line in highlight(block['text'].expandtabs(4), block['lang']):
        for piece in cut(line, inner - 2):
            used = sum(len(text) for text, _ in piece)
            rows.append(pad + [(' ', 'code')] + piece
                        + [(' ' * (inner - 1 - used), 'code')])
    return rows


def layout(page, width):
    """The rows of an answer at that width, each tagged with its block.

    A rule between two messages belongs to no block, so the cursor and the
    marks pass over it.
    """
    width, rows, number = max(20, width), [], 0
    found = page['blocks']
    for index, block in enumerate(found):
        if index:
            rows.append({'block': None, 'runs': [], 'code': False})
            if block['message'] != found[index - 1]['message']:
                rows.append({'block': None, 'runs': [(RULE * width, 'rule')], 'code': False})
                rows.append({'block': None, 'runs': [], 'code': False})
        if block['kind'] == 'code':
            number += 1
            drawn = panel(block, number, width)
        else:
            drawn = [row for line in block['source'].split('\n')
                     for row in prose(line, block['kind'], width)]
        rows.extend({'block': index, 'runs': runs, 'code': block['kind'] == 'code'}
                    for runs in drawn)
    return rows


def asked(prompt, width, most):
    """The rows of the prompt that the answer follows, on a ground of its own,
    at most `most` of them."""
    rows = []
    for n, line in enumerate(prompt.split('\n')):
        rows.extend(wrap([(('❯ ' if n == 0 else '  ') + line, 'prompt')], width, 2))
    if len(rows) > most:
        rows = rows[:most - 1] + [[(f'  … {len(rows) - most + 1} more lines',
                                    'prompt-more')]]
    return [row + [(' ' * (width - sum(len(text) for text, _ in row)), 'prompt')]
            for row in rows]


def shade(mine, chosen):
    """The suffix of the styles of a block: at the cursor, marked, or both."""
    return '-both' if mine and chosen else '-cursor' if mine \
        else '-mark' if chosen else ''


def tint(style, mine, chosen):
    """The style of a run in its block. The prose has no colour of a mark, and
    a marked paragraph at the cursor is lit as any paragraph at the cursor."""
    for suffix in (shade(mine, chosen), '-cursor' if mine else ''):
        if suffix and style + suffix in STYLES:
            return style + suffix
    return style


def view(rows, state, height):
    """The first row on screen: the one scrolled to, or one that shows the
    block at the cursor, from its top when it is taller than the screen."""
    last = max(0, len(rows) - height)
    top = state['top']
    if state['follow']:
        mine = [i for i, row in enumerate(rows) if row['block'] == state['cursor']]
        if mine and mine[0] < top:
            top = mine[0]
        elif mine and mine[-1] >= top + height:
            top = mine[0] if len(mine) >= height else mine[-1] - height + 1
    return max(0, min(last, top))


def palette():
    """The curses attribute of each style, in the colours the terminal has."""
    if not curses.has_colors():
        return {name: attr for name, (_, _, attr) in STYLES.items()}
    curses.start_color()
    try:
        curses.use_default_colors()
    except curses.error:
        pass
    pairs, look = {}, {}
    for name, (fg, bg, attr) in STYLES.items():
        if curses.COLORS < 256:
            fg, bg = BASIC.get(fg, -1), BASIC.get(bg, -1)
        if (fg, bg) not in pairs:
            pairs[(fg, bg)] = len(pairs) + 1
            curses.init_pair(pairs[(fg, bg)], fg, bg)
        look[name] = curses.color_pair(pairs[(fg, bg)]) | attr
    return look


def put(screen, row, column, text, attr=0):
    """Text cut at the right edge, which curses refuses to write past."""
    height, width = screen.getmaxyx()
    room = width - column - (1 if row == height - 1 else 0)
    if room > 0:
        try:
            screen.addnstr(row, column, text, room, attr)
        except curses.error:
            pass


def heading(book, state, keys=LETTERS):
    """The top line: which answer is on screen, and which of its messages.
    It names the mode, since w changes the blocks of the same answer."""
    count = book[state['page']]['messages']
    line = f" answer {state['page'] + 1}/{len(book)} · ← →"
    if state['every']:
        return line + f" · every message ({count}), {keys['every']} for the last"
    if count > 1:
        return line + f" · last of {count} messages, {keys['every']} for all"
    return line


def draw(screen, state, book, prompt, rows, look, keys, trouble):
    """The answer under its prompt, or the help when it is asked for.

    The help keeps the fault of a keys file in sight after the first key has
    cleared it from the bottom line.
    """
    screen.erase()
    height, width = screen.getmaxyx()
    put(screen, 0, 0, heading(book, state, keys), look['title'])
    corner = f"{keys['help']} help"
    put(screen, 0, max(0, width - len(corner) - 2), corner, look['help'])
    if state['help']:
        row = 2
        if trouble:
            for runs in wrap([(trouble, 'warn')], max(20, width - 6)):
                put(screen, row, 3, ''.join(text for text, _ in runs), look['warn'])
                row += 1
            row += 1
        lines = helped(keys)
        # a letter bound beside the named keys of an action widens its label
        column = max(17, 5 + max(len(shown_keys) for shown_keys, _ in lines))
        for y, (shown_keys, what) in enumerate(lines, row):
            put(screen, y, 3, shown_keys, look['help-key'])
            put(screen, y, column, what, look['text'])
        screen.refresh()
        return
    for y, runs in enumerate(prompt, 1):
        column = 0
        for text, style in runs:
            put(screen, y, column, text, look[style])
            column += len(text)
    first = len(prompt) + 2
    for y, row in enumerate(rows[state['top']:state['top'] + height - first - 1],
                            first):
        block = row['block']
        mine = block is not None and block == state['cursor']
        chosen = block is not None and block in state['marked']
        suffix = shade(mine, chosen)
        put(screen, y, 0, f"{state['top'] + y - first + 1:>4}", look['gutter' + suffix])
        if suffix:
            put(screen, y, 5, '┃', look['bar' + suffix])
        column = GUTTER
        for text, style in row['runs']:
            put(screen, y, column, text, look[tint(style, mine, chosen)])
            column += len(text)
        if mine and not row['code']:
            put(screen, y, column, ' ' * (width - column), look['text-cursor'])
    found = shown(book, state)['blocks']
    status = 'whole answer · ' if len(state['marked']) == len(found) > 1 else \
        f"{len(state['marked'])} marked · " if state['marked'] else ''
    if state['said']:
        put(screen, height - 1, 1, state['said'], look['warn'])
    else:
        put(screen, height - 1, 1, status + FOOTER.format_map(names(keys)), look['help'])
    screen.refresh()


def pick(book, keys, trouble):
    """Run the picker: the action that ended it, the text to copy and what it
    is called, or None if the user quits."""
    def run(screen):
        try:
            curses.curs_set(0)
        except curses.error:
            pass
        look, state, drawn = palette(), dict(opened(book), said=trouble), {}
        while True:
            height, width = screen.getmaxyx()
            page = shown(book, state)
            shape = (state['page'], state['every'], width, height)
            if shape not in drawn:
                drawn[shape] = (asked(page['prompt'], width, max(2, (height - 4) // 4)),
                                layout(page, width - GUTTER - 1))
            prompt, rows = drawn[shape]
            body = max(1, height - len(prompt) - 3)
            state = dict(state, top=view(rows, state, body))
            draw(screen, state, book, prompt, rows, look, keys, trouble)
            key = screen.get_wch()
            if isinstance(key, int):
                key = curses.keyname(key).decode()
            if key == '\x0c':
                screen.clear()
            state, done = step(dict(state, said=''), key, book, body, keys)
            if done in ('copy', *TO_RUN):
                try:
                    return (done, *prepared(done, state, shown(book, state)))
                except Refused as why:
                    state = dict(state, said=str(why))
            if done == 'quit':
                return None
    # Escape quits, and by default curses waits one second to tell a bare
    # Escape from the start of an arrow key
    os.environ.setdefault('ESCDELAY', '25')
    return curses.wrapper(run)


def type_into(pane_id, text):
    """Put the text in that pane as a paste, with no Enter, and focus it. The
    control characters come out, so that the text cannot end the paste."""
    api.call('pane', 'send_text', pane_id=pane_id,
             text=PASTE.format(CONTROLS.sub('', text)))
    api.call('pane', 'focus', pane_id=pane_id)


def place(agent, text):
    """Put the text in the prompt box of the agent without sending it, or say
    why not.

    A blocked agent would take the text as the answer to its dialog, and a box
    that holds a draft would take it as its tail. The status is read again,
    since the agent may have moved on while the picker was open.
    """
    agent = api.pane(agent['pane_id']) or agent
    if agent.get('agent_status') == 'blocked':
        return 'the agent is waiting on a dialog'
    held = prompting.box(prompting.screen(agent))
    if held is None:
        return 'the prompt box is not on screen'
    if held:
        return 'the prompt box already holds a line'
    type_into(agent['pane_id'], CONTROLS.sub('', text))
    return None


def say(line):
    """Print the line, and show it as a toast too: the pane closes as soon as
    the script exits."""
    print(line)
    api.call('notification', 'show', title='copy', body=line, sound='none')


def refuse(why):
    say(why)
    return 1


def launch(agent, blocks, what, keys=LETTERS):
    """Type the blocks into the free shell of the tab of the agent as a run of
    steps, without the Enter that starts it, or say why not.

    The shell is looked for once the picker has closed, since its command may
    have ended while the picker was open. The control characters come out
    before the check: with one at its end, a line that ends the run would pass.
    """
    blocks = [CONTROLS.sub('', block) for block in blocks]
    try:
        running.check(blocks, keys['shell'])
        shell, name = running.free_shell(api.panes(), agent, prompting.standing())
    except running.NoRun as why:
        return refuse(str(why))
    directory = running.prepare(agent, shell, name, again=keys['run'])
    type_into(shell['pane_id'], running.typed(directory, blocks))
    say(f'typed {what}, press Enter there to start the run in {directory}')
    return 0


def paste(agent, code, what):
    """Type the code into the free shell of the tab of the agent as it is,
    without the Enter that runs it, or say why not. The shell is looked for
    as for a run."""
    try:
        shell, name = running.free_shell(api.panes(), agent, prompting.standing(),
                                         heredoc=False)
    except running.NoRun as why:
        return refuse(str(why))
    type_into(shell['pane_id'], code)
    say(f"press Enter in pane {shell['pane_id']}{f' ({name})' if name else ''} "
        f"to run {what}")
    return 0


def main():
    panes = api.panes()
    pane = prompting.target(panes, prompting.standing())
    if not pane:
        return refuse('no agent in this tab, or two and you stand in neither')
    try:
        book = pages(sessions.find(pane, panes))
    except sessions.NoTranscript as why:
        return refuse(str(why))
    if not book:
        return refuse('no answer of Claude in this tab yet')

    # if no terminal reads the output, there is no picker, and the blocks of
    # the last answer go to the pipe instead
    if not sys.stdout.isatty():
        for block in book[-1]['blocks']:
            kind = (block['lang'] or 'code') if block['kind'] == 'code' else block['kind']
            print(f"{kind:<10} {first_line(block['text'])}")
        return 0

    keys, trouble = bindings()
    picked = pick(book, keys, trouble)
    if not picked:
        return 0
    done, text, what = picked
    if done == 'run':
        return launch(pane, text, what, keys=keys)
    if done == 'paste':
        return paste(pane, text, what)
    clip(text)
    line = said(what, text)
    if done == 'claude':
        why = place(pane, text)
        line += f', not put in the prompt box: {why}' if why \
            else ', and put in the prompt box'
    say(line)
    return 0


if __name__ == '__main__':
    sys.exit(main())
